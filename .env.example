SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql+psycopg2://postgres:<your-password>@localhost:5432/pd_dss
# PPMI data lives OUTSIDE the repo (raw CSVs in raw\, generated baselines in output\)
PPMI_DATA_DIR=C:\ppmi_data
# Tests use their OWN database (pytest drops and recreates all tables), name must end in _test
TEST_DATABASE_URL=postgresql+psycopg2://postgres:<your-password>@localhost:5432/pd_dss_test
